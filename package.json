{
  "name": "bama-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial Alabama Crimson Tide football hub: schedule, live stats, where-to-watch, radio, and an AI assistant.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
