# Copy this file to .env and fill in what you need. Restart after changes.

# ---------------------------------------------------------------------------
# Who can connect (only juno)
# ---------------------------------------------------------------------------
# The machine running Bama Hub can always connect to itself. Nobody else can
# unless they're listed below.
#
# Running Bama Hub ON juno? Leave these as they are and open
# http://localhost:3000 on juno. That's the most locked-down setup.
#
# Running it on another computer (a home server, a Pi) and browsing from juno?
#   1. Set HOST=0.0.0.0 so it listens on the network.
#   2. Put juno's IP address in ALLOWED_IPS (comma-separated; CIDR ranges OK).
#   3. Optional: also put juno's hostname in ALLOWED_HOSTNAMES. It is looked up
#      every few minutes, so if juno's IP changes it keeps working.
#      A DHCP reservation for juno on your router keeps its IP from changing.
HOST=127.0.0.1
PORT=3000
ALLOWED_IPS=
# ALLOWED_IPS=192.168.1.50
ALLOWED_HOSTNAMES=
# ALLOWED_HOSTNAMES=juno.local
# ALLOWED_HOSTNAMES_REFRESH_SECONDS=300

# Only if Bama Hub sits behind a reverse proxy (nginx, Caddy). Number of proxy
# hops to trust for X-Forwarded-For. Leave empty otherwise, or anyone could
# fake juno's address.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Tide AI (Claude)
# ---------------------------------------------------------------------------
# API key from https://platform.claude.com. Billed per question (usually cents).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (higher = more thorough, slower, pricier)
# CLAUDE_EFFORT=medium
# Let Tide AI search the web for news and injuries (true/false).
# AI_WEB_SEARCH=true
# Safety valve on spending: max messages per hour across all chats.
# AI_RATE_LIMIT_PER_HOUR=60

# ---------------------------------------------------------------------------
# CollegeFootballData.com (history, stats, recruiting, every game since 1869)
# ---------------------------------------------------------------------------
# Free key: https://collegefootballdata.com/key
CFBD_API_KEY=

# ---------------------------------------------------------------------------
# Watching
# ---------------------------------------------------------------------------
# Which live-TV service the Watch buttons point to:
# espn | youtubetv | hulu | fubo | sling | directv | antenna
WATCH_PROVIDER=espn

# ---------------------------------------------------------------------------
# Radio
# ---------------------------------------------------------------------------
# A live-audio stream URL you're entitled to use (MP3/AAC Icecast-style
# streams work best). Leave empty to show the official places to listen.
RADIO_STREAM_URL=
# Relay the stream through Bama Hub. Needed for the delay-to-sync-with-TV
# slider. Set to false to have the browser connect to the stream directly.
# RADIO_PROXY=true

# Time zone used for "today" in Tide AI's answers.
# TZ_DISPLAY=America/Chicago
